:"https://github.com/spectralDNS/spectralDNS/blob/master/demo/Isotropic.py","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"code","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"cdSmZhsdyh"}],"urlSource":"https://github.com/spectralDNS/spectralDNS/blob/master/demo/Isotropic.py","data":{"kind":"file","org":"spectralDNS","repo":"spectralDNS","reference":"master","file":"demo/Isotropic.py","raw":"https://raw.githubusercontent.com/spectralDNS/spectralDNS/master/demo/Isotropic.py"},"internal":false,"protocol":"github","key":"I0atVtVvrc"}],"key":"swIBTSKEnl"}],"key":"dgiAI05faJ"}],"key":"kQZYUwbLPh"},{"type":"block","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":13,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"Professor Mikael Mortensen received his PhD in mathematical modeling\nof turbulent reactive flows from ","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"t2JOhrovut"},{"type":"link","url":"http://www.chalmers.se/en/Pages/default.aspx","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"Chalmers University of Technology","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"gYEYZFg0m4"}],"urlSource":"http://www.chalmers.se/en/Pages/default.aspx","key":"u2Q56iQ8UN"},{"type":"text","value":", Sweden in 2005. He then worked for one year\nas a Post-Doctoral research fellow at the University of Sydney, in the world\nleading research group of Prof. Robert W. Bilger at the ","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"ZcMJW8u8GP"},{"type":"link","url":"http://web.aeromech.usyd.edu.au/index.php","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"School of Aerospace, Mechanical and Mechatronic\nEngineering","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"Oj6lUq4LXi"}],"urlSource":"http://web.aeromech.usyd.edu.au/index.php","key":"InJyaY8zld"},{"type":"text","value":". While in Sydney he\nworked mainly with developing mathematical models for spray combustion, and\nturbulent mixing of flows with multiple injections. Returning to Norway,\nhe worked with turbulence modelling and Computational Fluid Dynamics (CFD) for five years at the ","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"sBADDskLqh"},{"type":"link","url":"https://www.ffi.no","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"Norwegian Defence Research Establishment","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"x2jP7eDxIl"}],"urlSource":"https://www.ffi.no","key":"eK91a2WTw3"},{"type":"text","value":", before\narriving as an Associate Professor in 2012 at the ","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"Apecno0zhi"},{"type":"link","url":"http://www.uio.no","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"University of Oslo","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"pNcJsGxuFM"}],"urlSource":"http://www.uio.no","key":"k1U3Ktzze5"},{"type":"text","value":", Norway. Since May 2019 he has been working as full Professor.","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"DikhqYGBXf"}],"key":"AfLlvRtdJD"},{"type":"paragraph","position":{"start":{"line":23,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"Prof. Mortensen is interested in CFD, scientific computing and the many aspects of turbulent fluid\nflows, ranging from physics, modeling, numerical methods, software implementation and applications.\nAnd since such topics as turbulence, CFD and scientific computing are relevant\nfor a wide range of\ndifferent research fields, his later research topics venture into fields\nsuch as plasma physics, biomedical flows, multiphase, numerical analysis and physics informed neural networks.\nHe has been working extensively with finite element (FEniCS) and spectral codes for Direct\nNumerical Simulation (DNS) of turbulence, with codes preferably written in the high-level Python language. His latest venture is the open-source Jaxfun code that is using JAX for high-performance spectral Galerkin and Physics-Informed Neural Networks on CPUs, GPUs and TPUs.","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"COQAaKT1Ql"}],"key":"XbC1I06ktS"},{"type":"paragraph","position":{"start":{"line":32,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"If you are interested in learning more about the different research projects, please\nfollow the links in the Research tab at the top of this page for extended information.","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"zI9kGe7gXx"}],"key":"LIuLCtx7b3"}],"key":"pU6XnWJBLS"}],"key":"s00skz4NGh"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Professor Mikael Mortensen","url":"/","group":"Professor Mikael Mortensen"},"next":{"title":"CV","url":"/content/cv","group":"Professor Mikael Mortensen"}}},"domain":"http://localhost:3000"}